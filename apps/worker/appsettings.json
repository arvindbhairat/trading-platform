{
  "Telemetry": {
    "Otlp": {
      "PrimaryEndpoint": "http://localhost:4317",
      "FallbackEndpoint": "http://localhost:14317",
      "UseFallbackEndpoint": false,
      "ExportTimeoutMilliseconds": 5000
    }
  },
  "SignalStack": {
    "Bootstrap": {
      "AppConfiguration": {
        "Endpoint": "https://local-appconfig.signalstack",
        "SnapshotPath": "bootstrap/appconfig.local.json",
        "RefreshIntervalSeconds": 300
      },
      "KeyVault": {
        "VaultUri": "https://local-keyvault.signalstack",
        "SnapshotPath": "bootstrap/keyvault.local.json"
      },
      "LastKnownGood": {
        "CachePath": "bootstrap/appconfig.lkg.json",
        "MaxAgeSeconds": 86400,
        "StalenessAlertThresholdSeconds": 21600
      }
    }
  },
  "WorkerSingleton": {
    "LeaseKey": "rme:worker:singleton",
    "LeaseTtlSeconds": 60,
    "RefreshIntervalSeconds": 20,
    "HeartbeatIntervalSeconds": 10
  },
  "HistoricDataSeed": {
    "PollIntervalSeconds": 30,
    "HistoricalYearsBack": 10,
    "BatchSize": 500
  },
  "NotificationDelivery": {
    "PollIntervalSeconds": 10,
    "BatchSize": 50,
    "TelegramApiTimeoutSeconds": 15
  },
  "DataSync": {
    "PollIntervalSeconds": 120,
    "RecoverySessionCount": 10,
    "BatchSize": 50,
    "BulkInsertBatchSize": 1000
  },
  "LiveMarketScan": {
    "PollIntervalSeconds": 90,
    "CapacityWarnPct": 80,
    "MaxPositionsPerCycle": 500,
    "StaleQuoteCircuitThreshold": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

