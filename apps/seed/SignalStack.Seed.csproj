<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SignalStack.Seed</AssemblyName>
    <RootNamespace>SignalStack.Seed</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\migrations\SignalStack.Migrations\SignalStack.Migrations.csproj" />
  </ItemGroup>

  <!-- Transitive dependency overrides: pinned to resolve known vulnerabilities -->
  <ItemGroup>
    <!-- SharpCompress: transitive from MongoDB.Driver; pinned to fix CVE-2026-44788 (directory traversal) -->
    <PackageReference Include="SharpCompress" Version="0.47.4" />
  </ItemGroup>

</Project>
