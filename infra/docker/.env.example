ACCEPT_EULA=Y

# IMPORTANT: Change this in your local `.env` before first run.
# Must meet SQL Server password policy (upper, lower, number, symbol, >= 8 chars).
MSSQL_SA_PASSWORD=ChangeMe!12345

# Optional port overrides
MONGO_PORT=27017
MSSQL_PORT=1433
REDIS_PORT=6379

# Optional: override DB names (used by apps later)
MONGO_DATABASE=signalstack
