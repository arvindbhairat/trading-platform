{
  "endpoint": "/api/v1/auth/legal/versions",
  "method": "GET",
  "auth": "required",
  "description": "Returns current legal document versions from sys_config (REQ-LEGAL-004/008, REQ-PRIVACY-003)",
  "responseFields": [
    { "path": "tos_version", "type": "string", "required": true, "description": "Current Terms of Service version" },
    { "path": "privacy_version", "type": "string", "required": true, "description": "Current Privacy Policy version" },
    { "path": "tester_acknowledgement_version", "type": "string", "required": true, "description": "Current tester acknowledgement version" }
  ],
  "statusCodes": [200]
}
