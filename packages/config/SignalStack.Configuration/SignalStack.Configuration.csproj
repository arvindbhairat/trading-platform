<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SignalStack.Configuration</AssemblyName>
    <RootNamespace>SignalStack.Configuration</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenTelemetry">
      <HintPath>$(USERPROFILE)\.nuget\packages\opentelemetry\1.15.3\lib\net10.0\OpenTelemetry.dll</HintPath>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>$(USERPROFILE)\.nuget\packages\serilog\4.2.0\lib\net8.0\Serilog.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Extensions.Logging">
      <HintPath>$(USERPROFILE)\.nuget\packages\serilog.extensions.logging\8.0.0\lib\net8.0\Serilog.Extensions.Logging.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Sinks.Console">
      <HintPath>$(USERPROFILE)\.nuget\packages\serilog.sinks.console\6.0.0\lib\net8.0\Serilog.Sinks.Console.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
