<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SignalStack.Migrations</AssemblyName>
    <RootNamespace>SignalStack.Migrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
  </ItemGroup>

  <!-- Transitive dependency overrides: pinned to resolve known vulnerabilities -->
  <ItemGroup>
    <!-- SharpCompress: transitive from MongoDB.Driver; pinned to fix CVE-2026-44788 (directory traversal) -->
    <PackageReference Include="SharpCompress" Version="0.47.4" />
  </ItemGroup>
</Project>
