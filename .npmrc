# Use legacy peer-dep resolution.
# Required for npm 11.x (Node 24) — arborist's dedup pass in npm >=11.12 crashes
# on optional peer deps with non-standard version strings (e.g. babel-plugin-react-compiler)
# when strict peer dep resolution is active. legacy-peer-deps restores npm 6 behaviour
# and bypasses that code path. Re-evaluate when npm fixes the underlying arborist bug.
legacy-peer-deps=true
